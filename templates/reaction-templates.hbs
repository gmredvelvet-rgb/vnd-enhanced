<div class="vne-rt-root">
  <div class="form-group">
    <label>{{vnd-enhanced.settings.reactionMenu.newName}}</label>
    <div class="form-fields">
      <input type="text" name="templateName" />
      <button class="button vne-rt-save">{{vnd-enhanced.ui.save}}</button>
    </div>
    <p class="hint">{{vnd-enhanced.settings.reactionMenu.hint}}</p>
  </div>

  <hr />

  <h4>{{vnd-enhanced.settings.reactionMenu.existing}}</h4>
  <div class="vne-rt-list">
    {{#each templates}}
      <div class="vne-rt-item">
        <strong>{{@key}}</strong>
        <div class="vne-rt-actions">
          <button class="button vne-rt-apply" data-name="{{@key}}">{{vnd-enhanced.ui.apply}}</button>
          <button class="button vne-rt-delete" data-name="{{@key}}">{{vnd-enhanced.ui.delete}}</button>
        </div>
        <div class="vne-rt-preview">
          {{#each this}}
            {{#with ../portraits.[@key]}}
              <div class="vne-rt-preview-por" title="{{this.name}}">
                <img src="{{this.img}}" alt="{{this.name}}"/>
                <div class="vne-rt-preview-tag">{{this.activeReaction}}</div>
              </div>
            {{/with}}
          {{/each}}
        </div>
      </div>
    {{/each}}
  </div>
</div>
